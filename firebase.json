{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**/*.@(js|mjs|wasm|html|css)",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
      },
      {
        "source": "**/*.@(webp|png|jpg|jpeg|gif|svg|ico)",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, immutable" }]
      }
    ]
  }
}
